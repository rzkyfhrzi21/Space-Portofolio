eyebrow":"TENTANG SAYA","heading":"Tentang","headlinePart1":"Engineer","headlinePart2":"di balik karya.","intro":"Pengenalan singkat tentang siapa saya.","role":"Full-Stack Engineer - AI Systems Developer - Backend Architecture Specialist","roleSeparator":" - ","paragraphs":["Saya Aditya Imam Zuhdi, seorang Full-Stack Software Engineer yang berbasis di Indonesia dan saat ini bekerja di Telkomsigma. Saya mengembangkan aplikasi web dan sistem backend menggunakan JavaScript, Python, Go, dan Java, serta framework seperti Next.js, Laravel, Django, FastAPI, dll.","Saya senang membangun aplikasi yang membantu menyelesaikan masalah nyata, mulai dari membuat UI/UX yang nyaman digunakan hingga mengembangkan backend dan API. Saat ini saya juga terus memperdalam arsitektur backend modern dan penerapan AI untuk menciptakan produk digital yang bermanfaat."],"closing":"Salam hangat,","signature":"Aditya","signatureAlt":"Tanda tangan","profileImageAlt":"Aditya Imam Zuhdi","profileFileName":"aditya.jpg","profileName":"Aditya Imam Zuhdi","profileRole":"Programmer - Telkomsigma","status":"Tersedia","stats":[{"value":"3+","label":"Tahun Pengalaman"},{"value":"15+","label":"Proyek Dibangun"},{"value":"AI","label":"Pengembangan Sistem"}]},"stats":{"items":[{"value":"3","suffix":"+","label":"Tahun Pengalaman"},{"value":"15","suffix":"+","label":"Proyek Selesai"},{"value":"10","suffix":"+","label":"Klien yang Dilayani"}]},"aiCapability":{"headingPrefix":"","heading":"Pengembangan Sistem AI","subtitle":"Merancang dan membangun sistem cerdas yang didukung oleh teknologi AI modern.","items":[{"title":"Sistem RAG","desc":"Merancang pipeline Retrieval-Augmented Generation yang menggabungkan LLM dengan vector database untuk menghasilkan respons yang kontekstual dan berbasis data nyata."},{"title":"Integrasi LLM","desc":"Mengintegrasikan large language model seperti OpenAI GPT dan Google Gemini ke dalam aplikasi web untuk menghadirkan otomasi, workflow cerdas, dan fitur berbasis AI."},{"title":"AI Chatbots & Asisten","desc":"Membangun sistem AI percakapan termasuk chatbot dan asisten virtual dengan memori multi-gilir, kloning kepribadian, dan integrasi dengan platform seperti WhatsApp."},{"title":"Pencarian Knowledge Base","desc":"Mengembangkan sistem pencarian semantik menggunakan vector embedding untuk mengambil pengetahuan yang relevan dengan cepat dari koleksi dokumen besar."}]},"grid":{"item1Title":"Membangun sistem backend yang scalable dan aplikasi web modern menggunakan teknologi seperti Go, Python, dan Next.js.","item1Desc":"Fokus Utama","item2Title":"Menggabungkan prinsip engineering yang kuat dengan pendekatan thoughtful terhadap user experience dan visual design.","item2Desc":"Teknologi & Desain","item3Title":"Terbiasa berkolaborasi lintas zona waktu","item6Title":"Saat ini mengembangkan aplikasi full-stack yang scalable dengan fokus pada performa dan keandalan","item6Desc":"Sedang Dikerjakan","item7Title":"Tertarik memulai proyek bersama?"},"techStack":{"heading":"Tech Stack","headingPrefix":"","subtitle":"Kumpulan teknologi yang sering saya gunakan untuk membangun aplikasi yang scalable, mudah dikelola, dan berkinerja tinggi"},"selectedWorks":{"eyebrow":"Karya Pilihan","headingPart1":"Proyek","headingPart2":"unggulan","subtitle":"Pilihan proyek yang pernah saya kerjakan, dari konsep hingga peluncuran.","viewAll":"Lihat semua karya","projectTypes":{"aiRag":"Sistem AI / RAG","aiRagMobile":"AI / RAG","pwa":"Full-Stack - PWA","pwaMobile":"Full-Stack / PWA","backend":"Full-Stack - REST API","backendMobile":"Full-Stack / API","default":"Full-Stack"}},"experience":{"heading":"Pengalaman Kerja","headingPrefix":"","eyebrow":"Pengalaman Saya","titlePart1":"Riwayat","titlePart2":"kerja.","subtitle":"Perusahaan dan peran yang membentuk perjalanan engineering saya.","summary":"3 Peran dalam 3+ Tahun","keyAchievements":"Dampak:","currentLabel":"Saat ini","jobs":[{"id":1,"title":"Programmer","company":"PT Sigma Cipta Caraka (Telkomsigma)","duration":"Jul 202