 project?","headingPart1":"Let\'s build something","headingPart2":"impactful.","cta":"Let\'s Connect","availability":"Open to opportunities"},"projects":{"heading":"Projects","headingPrefix":"Selected","items":[{"id":1,"title":"WhatsApp AI Chatbot with RAG","des":"An intelligent backend system that clones a user\'s personality using Retrieval-Augmented Generation (RAG) for personalized automated replies.","tags":["AI / RAG","LangChain","Vector DB","WhatsApp API"],"highlights":["Engineered RAG pipeline using LangChain, OpenAI API, and Gemini AI for context-aware responses","Integrated Vector Database mapping user messages to retrieve relevant personality traits","Containerized with Docker for high scalability on concurrent WhatsApp webhooks","Implemented LLM-based document comparison and automated versioning features"]},{"id":2,"title":"Celestial Scroll - Novel Reader","des":"A modern web-based reading platform for light novel readers featuring customizable reading experiences and Progressive Web App support.","tags":["Full-Stack","PWA","React","Supabase"],"highlights":["Developed with Next.js, React, and Tailwind CSS for a seamless reading experience","Robust database management using Supabase and PostgreSQL","Optimized performance with caching strategies and PWA for offline access"]},{"id":3,"title":"POS System - Cemanting Art","des":"A full-stack POS system designed to help small businesses manage transactions, financial records, and profit/loss reporting.","tags":["Full-Stack","Backend","Node.js","MySQL"],"highlights":["Built scalable REST API architecture using Node.js and Express.js","Relational database schema with MySQL for complex transactions and reporting","Secure authentication and role-based access control"]},{"id":4,"title":"E-Learning School Platform","des":"An online learning platform featuring course material management, assignment tracking, and communication tools for students and teachers.","tags":["Full-Stack","Laravel","Livewire","MySQL"],"highli