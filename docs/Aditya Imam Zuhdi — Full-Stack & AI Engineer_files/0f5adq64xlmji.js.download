."},{"title":"AI Chatbots & Assistants","desc":"Building conversational AI systems including chatbots and virtual assistants with multi-turn memory, personality cloning, and integrations with platforms like WhatsApp."},{"title":"Knowledge Base Search","desc":"Developing semantic search systems using vector embeddings to retrieve relevant knowledge quickly from large document collections."}]},"grid":{"item1Title":"Building scalable backend systems and modern web applications using technologies such as Go, Python, and Next.js.","item1Desc":"Core Focus","item2Title":"Combining strong engineering principles with a thoughtful approach to user experience and visual design.","item2Desc":"Technology & Design","item3Title":"Comfortable collaborating across different time zones","item6Title":"Currently developing scalable full-stack applications focused on performance and reliability","item6Desc":"Currently Working On","item7Title":"Interested in starting a project together?"},"techStack":{"heading":"Tech Stack","headingPrefix":"My","subtitle":"A collection of technologies I frequently use to build scalable, maintainable, and high-performance applications"},"selectedWorks":{"eyebrow":"Selected Work","headingPart1":"Featured","headingPart2":"projects","subtitle":"A selection of projects I\'ve worked on, from concept to launch.","viewAll":"View all work","projectTypes":{"aiRag":"AI / RAG System","aiRagMobile":"AI / RAG","pwa":"Full-Stack - PWA","pwaMobile":"Full-Stack / PWA","backend":"Full-Stack - REST API","backendMobile":"Full-Stack / API","default":"Full-Stack"}},"experience":{"heading":"Work Experience","headingPrefix":"My","eyebrow":"My Experience","titlePart1":"Work","titlePart2":"history.","subtitle":"Companies and roles that shaped my engineering career.","summary":"3 Roles in 3+ Years","keyAchievements":"Impact:","currentLabel":"Current","jobs":[{"id":1,"title":"Programmer","company":"PT Sigma Cipta Caraka (Telkomsigma)","duration":"Jul 2024 - Present","desc":"Develop