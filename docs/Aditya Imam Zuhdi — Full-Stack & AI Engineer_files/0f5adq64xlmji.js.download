 Tailwind CSS.","Conducted functional, integration, and performance testing."]}]},"education":{"heading":"Certifications","headingPrefix":"Education &","eyebrow":"Education & Certifications","educationLabel":"Education","certificationsLabel":"Certifications","viewAll":"View All","clickToView":"Click to view","degreeBadges":{"gpa":"GPA 3.94","level":"S1"},"degrees":[{"id":1,"degree":"Bachelor of Informatics Engineering","institution":"Telkom University - Full Academic Scholarship","year":"2020 - 2024","description":"Awarded a full academic scholarship for four years through a merit-based selection process. Actively involved in student organizations and served as a teaching assistant for Data Communication Networks and Web Programming."}],"certs":[{"id":1,"name":"Prompt Engineering for Developers","fullName":"Prompt Engineering for Software Developers","issuer":"Certification","year":"2025","icon":"AI","img":"/assets/certifications/prompt-engineering-developers.png","desc":"Covers advanced prompt engineering techniques for developers - structured outputs, few-shot prompting, and integrating LLMs into production applications."},{"id":2,"name":"Microsoft Azure AI Fundamentals","fullName":"Microsoft Certified: Azure AI Fundamentals","issuer":"Microsoft","year":"2025","icon":"AZ","img":"/assets/certifications/microsoft-azure-ai-fundamentals.jpg","desc":"Official Microsoft certification covering core AI and machine learning concepts, Azure AI services, computer vision, NLP, and responsible AI principles."},{"id":3,"name":"Junior Web Developer","fullName":"Junior Web Developer","issuer":"BNSP Indonesia","issuerFull":"BNSP Indonesia (National Professional Certification Agency)","year":"2024","icon":"WD","img":"/assets/certifications/bnsp-junior-web-developer.jpg","desc":"National professional certification from BNSP validating competency in web development including frontend, backend, and deployment of web applications."},{"id":4,"name":"NestJS Zero to Hero","fullName":"Nest