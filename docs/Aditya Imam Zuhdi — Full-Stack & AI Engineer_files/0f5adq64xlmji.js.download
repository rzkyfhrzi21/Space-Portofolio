.","Migrasi website WordPress ke stack modern menggunakan Next.js, Express.js, dan Tailwind CSS.","Melakukan pengujian fungsional, integrasi, dan performa."]}]},"education":{"heading":"Sertifikasi","headingPrefix":"Pendidikan &","eyebrow":"Pendidikan & Sertifikasi","educationLabel":"Pendidikan","certificationsLabel":"Sertifikasi","viewAll":"Lihat Semua","clickToView":"Klik untuk lihat","degreeBadges":{"gpa":"IPK 3.94","level":"S1"},"degrees":[{"id":1,"degree":"Sarjana Teknik Informatika","institution":"Universitas Telkom - Beasiswa Akademik Penuh","year":"2020 - 2024","description":"Penerima beasiswa penuh selama empat tahun melalui proses seleksi berbasis prestasi. Aktif dalam organisasi kemahasiswaan dan berperan sebagai asisten praktikum untuk Jaringan Komunikasi Data dan Pemrograman Web."}],"certs":[{"id":1,"name":"Prompt Engineering untuk Developer","fullName":"Prompt Engineering untuk Software Developer","issuer":"Sertifikasi","year":"2025","icon":"AI","img":"/assets/certifications/prompt-engineering-developers.png","desc":"Mencakup teknik prompt engineering tingkat lanjut untuk developer - structured outputs, few-shot prompting, dan integrasi LLM ke aplikasi production."},{"id":2,"name":"Microsoft Azure AI Fundamentals","fullName":"Microsoft Certified: Azure AI Fundamentals","issuer":"Microsoft","year":"2025","icon":"AZ","img":"/assets/certifications/microsoft-azure-ai-fundamentals.jpg","desc":"Sertifikasi resmi Microsoft yang mencakup konsep inti AI dan machine learning, layanan Azure AI, computer vision, NLP, dan prinsip responsible AI."},{"id":3,"name":"Junior Web Developer","fullName":"Junior Web Developer","issuer":"BNSP Indonesia","issuerFull":"BNSP Indonesia (Badan Nasional Sertifikasi Profesi)","year":"2024","icon":"WD","img":"/assets/certifications/bnsp-junior-web-developer.jpg","desc":"Sertifikasi profesi nasional dari BNSP yang memvalidasi kompetensi pengembangan web, termasuk frontend, backend, dan deployment aplikasi web."},{"id":4,"name":"NestJS